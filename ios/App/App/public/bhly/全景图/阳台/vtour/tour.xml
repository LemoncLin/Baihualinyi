<krpano version="1.23" title="Virtual Tour">

	<include url="skin/vtourskin.xml" />

	<!-- customize skin settings: maps, gyro, webvr, thumbnails, tooltips, layout, design, ... -->
	<skin_settings maps="false"
	               maps_type="openstreetmaps"
	               maps_bing_api_key=""
	               maps_google_api_key=""
	               maps_zoombuttons="false"
	               maps_loadonfirstuse="true"
	               gyro="true"
	               gyro_keeplookingdirection="false"
	               webvr="false"
	               webvr_keeplookingdirection="false"
	               webvr_prev_next_hotspots="false"
	               autotour="false"
	               littleplanetintro="false"
	               followmousecontrol="false"
	               title="false"
	               thumbs="false"
	               thumbs_width="120" thumbs_height="80" thumbs_padding="10" thumbs_crop="0|40|240|160"
	               thumbs_opened="false"
	               thumbs_text="false"
	               thumbs_dragging="true"
	               thumbs_onhoverscrolling="false"
	               thumbs_scrollbuttons="false"
	               thumbs_scrollindicator="false"
	               thumbs_loop="false"
	               tooltips_buttons="false"
	               tooltips_thumbs="false"
	               tooltips_hotspots="false"
	               tooltips_mapspots="false"
	               deeplinking="false"
	               loadscene_flags="MERGE"
	               loadscene_blend="OPENBLEND(0.5, 0.0, 0.75, 0.05, linear)"
	               loadscene_blend_prev="SLIDEBLEND(0.5, 180, 0.75, linear)"
	               loadscene_blend_next="SLIDEBLEND(0.5,   0, 0.75, linear)"
	               loadingtext=""
	               layout_width="100%"
	               layout_maxwidth="814"
	               controlbar_width="-24"
	               controlbar_height="40"
	               controlbar_offset="20"
	               controlbar_offset_closed="-40"
	               controlbar_overlap.no-fractionalscaling="10"
	               controlbar_overlap.fractionalscaling="0"
	               design_skin_images="vtourskin.png"
	               design_bgcolor="0x2D3E50"
	               design_bgalpha="0.8"
	               design_bgborder="0"
	               design_bgroundedge="1"
	               design_bgshadow="0 4 10 0x000000 0.3"
	               design_thumbborder_bgborder="3 0xFFFFFF 1.0"
	               design_thumbborder_padding="2"
	               design_thumbborder_bgroundedge="0"
	               design_text_css="color:#FFFFFF; font-family:Arial;"
	               design_text_shadow="1"
	               />

	<!-- 5 秒无操作后缓慢自动旋转；用户拖动会自动暂停，停手后再等 5 秒 -->
	<autorotate enabled="true"
	            waittime="5.0"
	            accel="0.5"
	            speed="2.0"
	            horizon="0.0"
	            tofov="off"
	            oneroundrange="360"
	            />

	<style name="dir_card_style"
	       type="container"
	       align="lefttop"
	       y="8"
	       y.mobile="5"
	       width="108"
	       width.mobile="78"
	       height="92"
	       height.mobile="66"
	       bgcolor="0x000000"
	       bgalpha="0.92"
	       bgborder="0"
	       bgroundedge="2"
	       bgcapture="true"
	       handcursor="true"
	       />

	<style name="dir_card_label_style"
	       type="text"
	       align="bottom"
	       y="4"
	       y.mobile="2"
	       width="100%"
	       height="22"
	       height.mobile="16"
	       css="color:#FFFFFF; font-family:Microsoft YaHei,Arial; font-size:11px; text-align:center;"
	       css.mobile="color:#FFFFFF; font-family:Microsoft YaHei,Arial; font-size:9px; text-align:center;"
	       background="false"
	       enabled="false"
	       />

	<style name="dir_thumb_style"
	       align="top"
	       width="100%"
	       height="66"
	       height.mobile="46"
	       enabled="false"
	       />

	<style name="ui_tool_btn"
	       type="container"
	       align="lefttop"
	       width="44"
	       width.mobile="40"
	       height="44"
	       height.mobile="40"
	       bgcolor="0x000000"
	       bgalpha="0.55"
	       bgroundedge="22"
	       bgcapture="true"
	       handcursor="true"
	       />

	<style name="ui_tool_icon"
	       style="skin_base"
	       align="center"
	       scale="0.45"
	       scale.mobile="0.40"
	       enabled="false"
	       />

	<style name="ui_tool_label"
	       type="text"
	       align="center"
	       width="100%"
	       height="100%"
	       vcenter="true"
	       background="false"
	       enabled="false"
	       css="color:#FFFFFF; font-family:Microsoft YaHei,Arial; font-size:12px; text-align:center; font-weight:bold;"
	       css.mobile="color:#FFFFFF; font-family:Microsoft YaHei,Arial; font-size:11px; text-align:center; font-weight:bold;"
	       />

	<action name="dir_update_active">
		set(layer[dir_card_1].bgborder, '0');
		set(layer[dir_card_2].bgborder, '0');
		set(layer[dir_card_3].bgborder, '0');
		if(xml.scene == 'scene_byzxpw_wjo6f', set(layer[dir_card_1].bgborder, '2 0xFFFFFF 0.95'); );
		if(xml.scene == 'scene_byzxpw_wet16f', set(layer[dir_card_2].bgborder, '2 0xFFFFFF 0.95'); );
		if(xml.scene == 'scene_byzxpw_bry26f', set(layer[dir_card_3].bgborder, '2 0xFFFFFF 0.95'); );
	</action>

	<action name="dir_go_1">loadscene(scene_byzxpw_wjo6f, null, MERGE, OPENBLEND(0.5, 0.0, 0.75, 0.05, linear));</action>
	<action name="dir_go_2">loadscene(scene_byzxpw_wet16f, null, MERGE, OPENBLEND(0.5, 0.0, 0.75, 0.05, linear));</action>
	<action name="dir_go_3">loadscene(scene_byzxpw_bry26f, null, MERGE, OPENBLEND(0.5, 0.0, 0.75, 0.05, linear));</action>

	<!-- 收缩 / 展开：收起位移勿超过 dir_toggle.x，否则箭头会被裁切 -->
	<action name="dir_toggle_bar">
		stopdelayedcall(dir_hits_enable);
		if(layer[dir_bar].state == 'opened',
			set(layer[dir_bar].state, 'closed');
			set(layer[dir_hit_1].enabled, false);
			set(layer[dir_hit_2].enabled, false);
			set(layer[dir_hit_3].enabled, false);
			if(device.mobile,
				tween(layer[dir_bar].x, -262, 0.45, easeOutCubic);
			  ,
				tween(layer[dir_bar].x, -358, 0.45, easeOutCubic);
			);
			set(layer[dir_toggle_icon].url, 'skin/dir_chevron_right.png');
		  ,
			set(layer[dir_bar].state, 'opened');
			tween(layer[dir_bar].x, 0, 0.45, easeOutCubic);
			set(layer[dir_toggle_icon].url, 'skin/dir_chevron_left.png');
			delayedcall(dir_hits_enable, 0.45,
				set(layer[dir_hit_1].enabled, true);
				set(layer[dir_hit_2].enabled, true);
				set(layer[dir_hit_3].enabled, true);
			);
		);
	</action>

	<action name="hide_vr_fs_buttons">
		if(layer[skin_btn_vr],
			set(layer[skin_btn_vr].visible, false);
			set(layer[skin_btn_vr].enabled, false);
			set(layer[skin_btn_vr].alpha, 0);
		);
		if(layer[skin_btn_fs],
			set(layer[skin_btn_fs].visible, false);
			set(layer[skin_btn_fs].enabled, false);
			set(layer[skin_btn_fs].alpha, 0);
		);
		if(layer[webvr_enterbutton],
			set(layer[webvr_enterbutton].visible, false);
			set(layer[webvr_enterbutton].enabled, false);
			set(layer[webvr_enterbutton].alpha, 0);
		);
		if(layer[webvr_exitbutton],
			set(layer[webvr_exitbutton].visible, false);
			set(layer[webvr_exitbutton].enabled, false);
			set(layer[webvr_exitbutton].alpha, 0);
		);
		if(layer[ui_tools],
			set(layer[ui_tools].visible, false);
			set(layer[ui_tools].enabled, false);
		);
		if(layer[ui_btn_vr],
			set(layer[ui_btn_vr].visible, false);
			set(layer[ui_btn_vr].enabled, false);
		);
		if(layer[ui_btn_fs],
			set(layer[ui_btn_fs].visible, false);
			set(layer[ui_btn_fs].enabled, false);
		);
	</action>

	<action name="hide_skin_controlbar">
		skin_hideskin(instant);
		set(layer[skin_layer].visible, false);
		set(layer[skin_layer].enabled, false);
		set(layer[skin_btn_show].visible, false);
		set(layer[skin_btn_show].enabled, false);
		set(layer[skin_btn_prev_fs].visible, false);
		set(layer[skin_btn_prev_fs].enabled, false);
		set(layer[skin_btn_next_fs].visible, false);
		set(layer[skin_btn_next_fs].enabled, false);
		hide_vr_fs_buttons();
	</action>

	<!-- VR：分屏立体 + 全屏（无头显时为模拟 WebVR） -->
	<action name="ui_enter_vr">
		if(device.fullscreensupport AND fullscreen == false, set(fullscreen, true); );
		webvr.enterVR();
	</action>

	<action name="ui_toggle_fs">
		if(device.fullscreensupport,
			switch(fullscreen);
		  ,
			<!-- iOS 等无原生全屏时，尽量走 krpano 兼容路径 -->
			set(display.iphonefullscreen, 1);
		);
	</action>

	<action name="ui_sync_fs_icon">
		if(fullscreen,
			set(layer[ui_btn_fs_label].html, '退出');
		  ,
			set(layer[ui_btn_fs_label].html, '全屏');
		);
	</action>

	<!-- 左右极限：默认手机 ±60；平板由 URL ?hl=40 覆盖 -->
	<action name="balcony_apply_hlimit">
		if(%1 !== null,
			set(balcony_hl, %1);
		);
		if(balcony_hl === null,
			if(hl !== null, copy(balcony_hl, hl), set(balcony_hl, 60); );
		);
		calc(view.hlookatmin, 0 - balcony_hl);
		set(view.hlookatmax, get(balcony_hl));
		set(view.limitview, lookat);
		set(control.bouncinglimits, false);
	</action>

	<!--
	  入场：小行星开场（无左右旋转）
	  俯视小行星 → 平滑展开到正常视角
	-->
	<action name="play_intro">
		if(intro_played == true, exit(); );
		set(intro_played, true);
		set(autorotate.enabled, false);
		set(control.usercontrol, off);

		set(intro_h, get(view.hlookat));
		set(intro_v, get(view.vlookat));
		set(intro_fov, get(view.fov));
		set(intro_fovmax, get(view.fovmax));

		set(view.fovmax, 170);
		set(view.limitview, off);
		set(view.architectural, 0.0);
		set(view.pannini, 0.0);
		lookat(get(intro_h), 90, 150, 1.0, 0, 0);

		delayedcall(intro_expand, 0.5,
			tween(view.vlookat, get(intro_v), 3.0, easeOutQuad);
			tween(view.fov, get(intro_fov), 3.0, easeOutQuad);
			tween(view.distortion, 0.0, 3.0, easeOutQuad);
			delayedcall(intro_done, 3.0,
				set(view.fovmax, get(intro_fovmax));
				balcony_apply_hlimit();
				set(control.usercontrol, all);
				set(autorotate.enabled, true);
				hide_skin_controlbar();
			);
		);
	</action>

	<events name="dir_events" keep="true"
	        onxmlcomplete="delayedcall(0.05, hide_skin_controlbar()); delayedcall(0.6, hide_vr_fs_buttons()); delayedcall(1.2, hide_vr_fs_buttons()); dir_update_active(); balcony_apply_hlimit();"
	        onnewscene="hide_skin_controlbar(); hide_vr_fs_buttons(); dir_update_active(); balcony_apply_hlimit();"
	        onloadcomplete="if(intro_played != true, play_intro(); ); hide_vr_fs_buttons(); balcony_apply_hlimit();"
	        onresize="hide_vr_fs_buttons();"
	        onenterfullscreen="ui_sync_fs_icon(); hide_vr_fs_buttons();"
	        onexitfullscreen="ui_sync_fs_icon(); hide_vr_fs_buttons();"
	        />

	<!-- 右上角 / 底栏 VR、全屏：强制隐藏（皮肤 arrange 后仍会再藏） -->

	<!-- 左侧场景切换条（参考景观漫游 vr）；手机整体再缩 30% -->
	<layer name="dir_root"
	       keep="true"
	       type="container"
	       align="leftbottom"
	       x="0"
	       y="40"
	       y.mobile="28"
	       width="420"
	       width.mobile="310"
	       height="110"
	       height.mobile="80"
	       scale.handheld="0.7"
	       bgcapture="false"
	       zorder="60"
	       vr="false"
	       >

		<layer name="dir_bar"
		       type="container"
		       state="opened"
		       align="lefttop"
		       x="0"
		       y="0"
		       width="410"
		       width.mobile="300"
		       height="110"
		       height.mobile="80"
		       alpha="1.0"
		       bgcolor="0x000000"
		       bgalpha="0.45"
		       bgroundedge="0 55 55 0"
		       bgroundedge.mobile="0 40 40 0"
		       bgcapture="true"
		       >

			<layer name="dir_card_1" style="dir_card_style" x="10" x.mobile="8">
				<layer url="panos/byzxpw_wjo6F.tiles/thumb.jpg" style="dir_thumb_style" />
				<layer style="dir_card_label_style" html="低区 6F" />
				<layer name="dir_hit_1" type="container" align="lefttop" width="100%" height="100%" bgcolor="0x000000" bgalpha="0" bgcapture="true" handcursor="true" zorder="20" onclick="dir_go_1();" />
			</layer>

			<layer name="dir_card_2" style="dir_card_style" x="126" x.mobile="92">
				<layer url="panos/byzxpw_wet16F.tiles/thumb.jpg" style="dir_thumb_style" />
				<layer style="dir_card_label_style" html="中区 16F" />
				<layer name="dir_hit_2" type="container" align="lefttop" width="100%" height="100%" bgcolor="0x000000" bgalpha="0" bgcapture="true" handcursor="true" zorder="20" onclick="dir_go_2();" />
			</layer>

			<layer name="dir_card_3" style="dir_card_style" x="242" x.mobile="176">
				<layer url="panos/byzxpw_bry26F.tiles/thumb.jpg" style="dir_thumb_style" />
				<layer style="dir_card_label_style" html="高区 26F" />
				<layer name="dir_hit_3" type="container" align="lefttop" width="100%" height="100%" bgcolor="0x000000" bgalpha="0" bgcapture="true" handcursor="true" zorder="20" onclick="dir_go_3();" />
			</layer>

			<!-- 折叠箭头 -->
			<layer name="dir_toggle"
			       type="container"
			       align="lefttop"
			       x="358"
			       x.mobile="262"
			       y="12"
			       y.mobile="8"
			       width="36"
			       width.mobile="28"
			       height="86"
			       height.mobile="64"
			       bgcolor="0x000000"
			       bgalpha="0"
			       bgroundedge="0"
			       bgcapture="true"
			       handcursor="true"
			       zorder="5"
			       maskchildren="true"
			       onclick="dir_toggle_bar();"
			       >
				<layer name="dir_toggle_icon"
				       url="skin/dir_chevron_left.png"
				       align="center"
				       width="26"
				       width.mobile="20"
				       height="32"
				       height.mobile="24"
				       enabled="false"
				       />
			</layer>

		</layer>
	</layer>

	<scene name="scene_byzxpw_wjo6f" title="阳台_低6F" onstart="" thumburl="panos/byzxpw_wjo6F.tiles/thumb.jpg" lat="" lng="" alt="" heading="">

		<control bouncinglimits="false" />

		<view hlookat="0.0" vlookat="0.0" fovtype="MFOV" fov="120" maxpixelzoom="2.0" fovmin="70" fovmax="125" limitview="lookat" hlookatmin="-60" hlookatmax="60" vlookatmin="-32" vlookatmax="42" />

		<preview url="panos/byzxpw_wjo6F.tiles/preview.jpg" />

		<image>
			<cube url="panos/byzxpw_wjo6F.tiles/%s/l%l/%v/l%l_%s_%v_%h.jpg" multires="512,640,1280,2560" />
		</image>

	</scene>

	<scene name="scene_byzxpw_wet16f" title="阳台_中16F" onstart="" thumburl="panos/byzxpw_wet16F.tiles/thumb.jpg" lat="" lng="" alt="" heading="">

		<control bouncinglimits="false" />

		<view hlookat="0.0" vlookat="0.0" fovtype="MFOV" fov="120" maxpixelzoom="2.0" fovmin="70" fovmax="125" limitview="lookat" hlookatmin="-60" hlookatmax="60" vlookatmin="-32" vlookatmax="42" />

		<preview url="panos/byzxpw_wet16F.tiles/preview.jpg" />

		<image>
			<cube url="panos/byzxpw_wet16F.tiles/%s/l%l/%v/l%l_%s_%v_%h.jpg" multires="512,640,1280,2560" />
		</image>

	</scene>

	<scene name="scene_byzxpw_bry26f" title="阳台_高26F" onstart="" thumburl="panos/byzxpw_bry26F.tiles/thumb.jpg" lat="" lng="" alt="" heading="">

		<control bouncinglimits="false" />

		<view hlookat="0.0" vlookat="0.0" fovtype="MFOV" fov="120" maxpixelzoom="2.0" fovmin="70" fovmax="125" limitview="lookat" hlookatmin="-60" hlookatmax="60" vlookatmin="-32" vlookatmax="42" />

		<preview url="panos/byzxpw_bry26F.tiles/preview.jpg" />

		<image>
			<cube url="panos/byzxpw_bry26F.tiles/%s/l%l/%v/l%l_%s_%v_%h.jpg" multires="512,640,1280,2560" />
		</image>

	</scene>


</krpano>
