<krpano version="1.23" title="Virtual Tour">

	<include url="skin/vtourskin.xml" />

	<data name="radar_group">pano</data>
	<include url="../radar.xml" />
	<include url="../../bhly_large_ui.xml?v=3" />

	<skin_settings maps="false"
	               maps_type="openstreetmaps"
	               maps_bing_api_key=""
	               maps_google_api_key=""
	               maps_zoombuttons="false"
	               maps_loadonfirstuse="true"
	               gyro="true"
	               gyro_keeplookingdirection="false"
	               webvr="true"
	               webvr_keeplookingdirection="true"
	               webvr_prev_next_hotspots="true"
	               autotour="false"
	               littleplanetintro="false"
	               followmousecontrol="false"
	               title="false"
	               thumbs="false"
	               thumbs_width="120" thumbs_height="80" thumbs_padding="10" thumbs_crop="0|40|240|160"
	               thumbs_opened="false"
	               thumbs_text="false"
	               thumbs_dragging="true"
	               thumbs_onhoverscrolling="false"
	               thumbs_scrollbuttons="false"
	               thumbs_scrollindicator="false"
	               thumbs_loop="false"
	               tooltips_buttons="false"
	               tooltips_thumbs="false"
	               tooltips_hotspots="false"
	               tooltips_mapspots="false"
	               deeplinking="false"
	               loadscene_flags="MERGE"
	               loadscene_blend="OPENBLEND(0.5, 0.0, 0.75, 0.05, linear)"
	               loadscene_blend_prev="SLIDEBLEND(0.5, 180, 0.75, linear)"
	               loadscene_blend_next="SLIDEBLEND(0.5,   0, 0.75, linear)"
	               loadingtext=""
	               layout_width="100%"
	               layout_maxwidth="814"
	               controlbar_width="-24"
	               controlbar_height="40"
	               controlbar_offset="20"
	               controlbar_offset_closed="-40"
	               controlbar_overlap.no-fractionalscaling="10"
	               controlbar_overlap.fractionalscaling="0"
	               design_skin_images="vtourskin.png"
	               design_bgcolor="0x2D3E50"
	               design_bgalpha="0.8"
	               design_bgborder="0"
	               design_bgroundedge="1"
	               design_bgshadow="0 4 10 0x000000 0.3"
	               design_thumbborder_bgborder="3 0xFFFFFF 1.0"
	               design_thumbborder_padding="2"
	               design_thumbborder_bgroundedge="0"
	               design_text_css="color:#FFFFFF; font-family:Arial;"
	               design_text_shadow="1"
	               />

	<autorotate enabled="true"
	            waittime="5.0"
	            accel="0.5"
	            speed="2.0"
	            horizon="0.0"
	            tofov="off"
	            oneroundrange="360"
	            />

	<style name="dir_card_style"
	       type="container"
	       align="lefttop"
	       y="8" y.mobile="5"
	       width="108" width.mobile="78"
	       height="92" height.mobile="66"
	       bgcolor="0x000000" bgalpha="0.92"
	       bgborder="0" bgroundedge="2"
	       bgcapture="true" handcursor="true"
	       />

	<style name="dir_card_label_style"
	       type="text"
	       align="bottom" y="4" y.mobile="2"
	       width="100%" height="22" height.mobile="16"
	       css="color:#FFFFFF; font-family:Microsoft YaHei,Arial; font-size:11px; text-align:center;"
	       css.mobile="color:#FFFFFF; font-family:Microsoft YaHei,Arial; font-size:9px; text-align:center;"
	       background="false" enabled="false"
	       />

	<style name="dir_thumb_style"
	       align="top" width="100%" height="66" height.mobile="46" enabled="false"
	       />

	<action name="dir_update_active">
		set(layer[dir_card_1].bgborder, '0');
		set(layer[dir_card_2].bgborder, '0');
		set(layer[dir_card_3].bgborder, '0');
		set(layer[dir_card_4].bgborder, '0');
		if(xml.scene == 'scene_zkixgpxjsxucxflxcg', set(layer[dir_card_1].bgborder, '2 0xFFFFFF 0.95'); );
		if(xml.scene == 'scene_yexwelwirbxy', set(layer[dir_card_2].bgborder, '2 0xFFFFFF 0.95'); );
		if(xml.scene == 'scene_ajhywnakxxbt', set(layer[dir_card_3].bgborder, '2 0xFFFFFF 0.95'); );
		if(xml.scene == 'scene_aqmxugwfqxbt', set(layer[dir_card_4].bgborder, '2 0xFFFFFF 0.95'); );
	</action>

	<action name="dir_go_1">
		if(xml.scene == 'scene_zkixgpxjsxucxflxcg', exit(); );
		loadscene(scene_zkixgpxjsxucxflxcg, null, MERGE, OPENBLEND(0.5, 0.0, 0.75, 0.05, linear));
	</action>
	<action name="dir_go_2">
		if(xml.scene == 'scene_yexwelwirbxy', exit(); );
		loadscene(scene_yexwelwirbxy, null, MERGE, OPENBLEND(0.5, 0.0, 0.75, 0.05, linear));
	</action>
	<action name="dir_go_3">
		if(xml.scene == 'scene_ajhywnakxxbt', exit(); );
		loadscene(scene_ajhywnakxxbt, null, MERGE, OPENBLEND(0.5, 0.0, 0.75, 0.05, linear));
	</action>
	<action name="dir_go_4">
		if(xml.scene == 'scene_aqmxugwfqxbt', exit(); );
		loadscene(scene_aqmxugwfqxbt, null, MERGE, OPENBLEND(0.5, 0.0, 0.75, 0.05, linear));
	</action>

	<action name="dir_toggle_bar">
		stopdelayedcall(dir_hits_enable);
		if(layer[dir_bar].state == 'opened',
			set(layer[dir_bar].state, 'closed');
			set(layer[dir_hit_1].enabled, false);
			set(layer[dir_hit_2].enabled, false);
			set(layer[dir_hit_3].enabled, false);
			set(layer[dir_hit_4].enabled, false);
			if(device.mobile,
				tween(layer[dir_bar].x, -346, 0.45, easeOutCubic);
			  ,
				tween(layer[dir_bar].x, -474, 0.45, easeOutCubic);
			);
			set(layer[dir_toggle_icon].url, 'skin/dir_chevron_right.png');
		  ,
			set(layer[dir_bar].state, 'opened');
			tween(layer[dir_bar].x, 0, 0.45, easeOutCubic);
			set(layer[dir_toggle_icon].url, 'skin/dir_chevron_left.png');
			delayedcall(dir_hits_enable, 0.45,
				set(layer[dir_hit_1].enabled, true);
				set(layer[dir_hit_2].enabled, true);
				set(layer[dir_hit_3].enabled, true);
				set(layer[dir_hit_4].enabled, true);
			);
		);
	</action>

	<action name="hide_skin_controlbar">
		skin_hideskin(instant);
		set(layer[skin_layer].visible, false);
		set(layer[skin_layer].enabled, false);
		set(layer[skin_btn_show].visible, false);
		set(layer[skin_btn_show].enabled, false);
		set(layer[skin_btn_prev_fs].visible, false);
		set(layer[skin_btn_prev_fs].enabled, false);
		set(layer[skin_btn_next_fs].visible, false);
		set(layer[skin_btn_next_fs].enabled, false);
		if(layer[webvr_enterbutton],
			set(layer[webvr_enterbutton].visible, false);
			set(layer[webvr_enterbutton].enabled, false);
		);
	</action>

	<!-- 入场：小行星开场（无左右旋转）平滑展开 —— 对齐第二版vtour -->
	<action name="play_intro">
		if(intro_played == true, exit(); );
		set(intro_played, true);
		set(autorotate.enabled, false);
		set(control.usercontrol, off);

		set(intro_h, get(view.hlookat));
		set(intro_v, get(view.vlookat));
		set(intro_fov, get(view.fov));
		set(intro_fovmax, get(view.fovmax));

		set(view.fovmax, 170);
		set(view.limitview, off);
		set(view.architectural, 0.0);
		set(view.pannini, 0.0);
		lookat(get(intro_h), 90, 150, 1.0, 0, 0);

		delayedcall(intro_expand, 0.5,
			tween(view.vlookat, get(intro_v), 3.0, easeOutQuad);
			tween(view.fov, get(intro_fov), 3.0, easeOutQuad);
			tween(view.distortion, 0.0, 3.0, easeOutQuad);
			delayedcall(intro_done, 3.0,
				set(view.fovmax, get(intro_fovmax));
				set(view.limitview, auto);
				set(control.usercontrol, all);
				set(autorotate.enabled, true);
				hide_skin_controlbar();
			);
		);
	</action>

	<events name="garden_pano_events"
	        keep="true"
	        onxmlcomplete="delayedcall(0.05, hide_skin_controlbar()); dir_update_active();"
	        onnewscene="hide_skin_controlbar(); dir_update_active();"
	        onloadcomplete="if(intro_played != true, play_intro(); );"
	        />

	<layer name="dir_root"
	       keep="true" type="container"
	       align="leftbottom" x="0" y="40" y.mobile="28"
	       width="530" width.mobile="390"
	       height="110" height.mobile="80"
	       scale.handheld="0.55"
	       bgcapture="false" zorder="60" vr="false"
	       >
		<layer name="dir_bar"
		       type="container" state="opened"
		       align="lefttop" x="0" y="0"
		       width="520" width.mobile="380"
		       height="110" height.mobile="80"
		       alpha="1.0" bgcolor="0x000000" bgalpha="0.45"
		       bgroundedge="0 55 55 0" bgroundedge.mobile="0 40 40 0"
		       bgcapture="true"
		       >
			<layer name="dir_card_1" style="dir_card_style" x="10" x.mobile="8">
				<layer url="panos/zkixgpxjsxucxflxcg.tiles/thumb.jpg" style="dir_thumb_style" />
				<layer style="dir_card_label_style" html="礼序归家" />
				<layer name="dir_hit_1" type="container" align="lefttop" width="100%" height="100%" bgcolor="0x000000" bgalpha="0" bgcapture="true" handcursor="true" zorder="20" onclick="dir_go_1();" />
			</layer>
			<layer name="dir_card_2" style="dir_card_style" x="126" x.mobile="92">
				<layer url="panos/yexwelwirbxy.tiles/thumb.jpg" style="dir_thumb_style" />
				<layer style="dir_card_label_style" html="林下休闲" />
				<layer name="dir_hit_2" type="container" align="lefttop" width="100%" height="100%" bgcolor="0x000000" bgalpha="0" bgcapture="true" handcursor="true" zorder="20" onclick="dir_go_2();" />
			</layer>
			<layer name="dir_card_3" style="dir_card_style" x="242" x.mobile="176">
				<layer url="panos/ajhywnakxxbt.tiles/thumb.jpg" style="dir_thumb_style" />
				<layer style="dir_card_label_style" html="轻氧花园" />
				<layer name="dir_hit_3" type="container" align="lefttop" width="100%" height="100%" bgcolor="0x000000" bgalpha="0" bgcapture="true" handcursor="true" zorder="20" onclick="dir_go_3();" />
			</layer>
			<layer name="dir_card_4" style="dir_card_style" x="358" x.mobile="260">
				<layer url="panos/aqmxugwfqxbt.tiles/thumb.jpg" style="dir_thumb_style" />
				<layer style="dir_card_label_style" html="萌宠乐园" />
				<layer name="dir_hit_4" type="container" align="lefttop" width="100%" height="100%" bgcolor="0x000000" bgalpha="0" bgcapture="true" handcursor="true" zorder="20" onclick="dir_go_4();" />
			</layer>

			<layer name="dir_toggle"
			       type="container" align="lefttop"
			       x="474" x.mobile="346"
			       y="12" y.mobile="8"
			       width="36" width.mobile="28"
			       height="86" height.mobile="64"
			       bgcolor="0x000000" bgalpha="0"
			       bgcapture="true" handcursor="true" zorder="5"
			       onclick="dir_toggle_bar();"
			       >
				<layer name="dir_toggle_icon"
				       url="skin/dir_chevron_left.png"
				       align="center" width="26" width.mobile="20" height="32" height.mobile="24"
				       enabled="false"
				       />
			</layer>
		</layer>
	</layer>

	<!-- 默认首场景：礼序归家 -->

<scene name="scene_zkixgpxjsxucxflxcg" title="礼序归家广场" onstart="" thumburl="panos/zkixgpxjsxucxflxcg.tiles/thumb.jpg" lat="" lng="" alt="" heading="">
		
